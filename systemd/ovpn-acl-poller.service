[Unit]
Description=OpenVPN Manager - sincroniza OVPN_ACL con clientes restringidos conectados
After=openvpn@server.service
Wants=openvpn@server.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/openvpn-manager/acl-poller.py
User=ovpn-acl
Group=ovpn-acl
RuntimeDirectory=openvpn-manager
RuntimeDirectoryMode=0750
StateDirectory=ovpn-acl
StateDirectoryMode=0750
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
