[Unit]
Description=OpenVPN Management GUI
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/openvpn/app
ExecStart=/usr/bin/python3 -m gunicorn --workers 1 --worker-class gthread --threads 4 --bind 127.0.0.1:5000 --timeout 120 --proxy-protocol --proxy-allow-from 127.0.0.1 --access-logfile /var/log/openvpn-gui-access.log app:app
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
